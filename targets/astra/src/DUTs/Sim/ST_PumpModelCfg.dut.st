// Назначение: характеристика насоса и сети для модели (законы подобия, рабочая точка, ток
//             двигателя). Значения по умолчанию — условные, подобраны под подачи документов
//             (DESIGN 11.3; сверяет эталон tools_project/plant_reference.py).
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, разделы 3.3, 11.2, 11.3
{attribute 'qualified_only'}
TYPE ST_PumpModelCfg :
STRUCT
    rH0_m      : REAL := 34.5;      // напор при нулевой подаче на 50 Гц
    rK_mh2     : REAL := 6.06E-4;   // крутизна характеристики, м/(м³/ч)²
    rHgeo_m    : REAL := 12.0;      // геометрический напор от дна резервуара
    rR_mh2     : REAL := 4.60E-4;   // сопротивление трубопровода, м/(м³/ч)²
    rEta       : REAL := 0.62;      // КПД агрегата
    rPnom_kW   : REAL := 15.0;
    rInom_A    : REAL := 28.0;
    rImagShare : REAL := 0.30;      // доля намагничивающего тока
    rLossShare : REAL := 0.12;      // потери без подачи, доля Pnom
END_STRUCT
END_TYPE
