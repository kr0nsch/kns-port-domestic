// Установить уровень (xResetPlant, xSetLevel): ограничивается 0…rOverflow_m последнего вызова;
// неконечное значение не принимается. Уровень и признак осушенного приёмка — сразу (по ним гидравлика
// считает подачу в том же вызове модели), остальные выходы — ближайший вызов тела
METHOD PUBLIC SetLevel
VAR_INPUT
    rNewLevel_m : REAL;     // новый уровень
END_VAR
