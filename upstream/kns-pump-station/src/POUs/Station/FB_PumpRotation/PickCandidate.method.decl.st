// Насос для нового запроса (04 §5.2): сначала ReadyToStart, затем доступные в паузе (tMinStop,
// лимит пусков: запрос подождёт); внутри группы — по режиму чередования. xNeedComm — назначается
// ведущий в ПИД: сначала насосы со связью с ПЧ; если таких нет, — любой (станция откачивает, ПИД
// без связи не готов, и действует ступенчатое, 04 §12); при передаче роли (xReadyOnly) — только со связью.
// 0 — кандидата нет
METHOD PRIVATE PickCandidate : UINT
VAR_INPUT
    eRot       : E_RotationMode;        // режим чередования
    uiNext     : UINT;                  // Cyclic: следующий ведущий
    xNeedComm  : BOOL;                  // предпочесть насосы со связью
    xReadyOnly : BOOL;                  // только готовые к пуску (передача роли)
END_VAR
