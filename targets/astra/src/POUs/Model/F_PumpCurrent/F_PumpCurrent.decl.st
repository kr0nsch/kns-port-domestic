// Назначение: ток двигателя насоса в модели, А. Гидравлическая мощность
//             P_hyd = ρ·g·(q/3600)·H/1000 кВт; потребляемая P = max(P_hyd/η, rLossShare·Pnom·s³) —
//             не меньше потерь без подачи, поэтому ток непрерывен при закрытии обратного клапана;
//             I = rImagShare·Inom·s + (1 − rImagShare)·Inom·P/Pnom. Без вращения (s ≤ 0), при
//             неверной характеристике или неконечных входах — 0.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, разделы 11.2, 11.3
FUNCTION F_PumpCurrent : REAL
VAR_INPUT
    rFlow_m3h : REAL;           // подача насоса
    rHead_m   : REAL;           // напор сети в рабочей точке
    rSpeed    : REAL;           // относительная скорость s = f / 50 Гц
    stPump    : ST_PumpModelCfg;  // характеристика насоса и двигателя
END_VAR
VAR
    rHyd_kW  : REAL;            // гидравлическая мощность
    rLoss_kW : REAL;            // потери без подачи
    rIn_kW   : REAL;            // потребляемая мощность
END_VAR
