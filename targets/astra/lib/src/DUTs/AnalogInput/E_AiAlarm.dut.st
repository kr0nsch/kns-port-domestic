// Назначение: индексы слотов тревог аналогового входа (afbAlarm[i], astAlarm[i]) и уставок
//             (astLimit[HH..LL]). Нестрогое перечисление: им индексируются массивы.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/fb/FB_AnalogInput.md
{attribute 'qualified_only'}
TYPE E_AiAlarm :
(
    HH         := 0,   // верхняя аварийная уставка
    H          := 1,   // верхняя предупредительная уставка
    L          := 2,   // нижняя предупредительная уставка
    LL         := 3,   // нижняя аварийная уставка
    Failure    := 4,   // подтверждённый отказ сигнала
    OutOfRange := 5    // сигнал вне диапазона измерения (NE 43)
) UINT;
END_TYPE
