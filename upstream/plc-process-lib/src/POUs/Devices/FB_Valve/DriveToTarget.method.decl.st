// Шаг 6.7: переходы движения к цели. Motorized: смена направления в ходе — через Reversing, стоп —
// Intermediate, встречное включение после остановки — не раньше tReverse (выбег); соленоид: смена цели —
// сразу другое направление; муфта в ходе — TorqueTrip, кроме страгивания с седла (VLV-21).
// Шаг тела FB_Valve; внутренний: PROTECTED (правило L5 контракта), имя зарезервировано для наследников
METHOD PROTECTED DriveToTarget
VAR
    xHoldOpen  : BOOL;   // открывать пока нельзя: «закрывать» снят меньше tReverse назад
    xHoldClose : BOOL;   // закрывать пока нельзя: «открывать» снят меньше tReverse назад
    xUnseating : BOOL;   // клин выходит из седла: муфта открытия — не заклинивание (VLV-21)
END_VAR
