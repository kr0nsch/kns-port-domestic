// Назначение: медленная задача (SlowTask): выгрузка снимка журнала в CSV по запросу MainTask
//             (GVL_Log.xExportReq). Запрос принимается, когда выгрузка не идёт, и снимается сразу после
//             публикации состояния Writing: MainTask ставит запрос только вне Writing, поэтому запись TRUE
//             из MainTask не теряется при вытеснении SlowTask (повторная команда до старта сливается с
//             первой). Число строк и код ошибки публикуются раньше состояния Done/Error: MainTask по
//             переходу состояния пишет событие с ними. Файловые операции не влияют на цикл логики (D-09).
// Автор:      kr0nsch
// Версия:     0.2.0
// Документ:   docs/DESIGN.md, разделы 4.3, 9.2
PROGRAM PRG_Slow
VAR
    fbCsv  : FB_EventLogCsv;        // выгрузка журнала
    xStart : BOOL;                  // запрос MainTask принят в этом цикле
END_VAR
