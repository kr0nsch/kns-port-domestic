// Шаг 6.3 цикла (LREAL): нормировка по типу входа, корень и отсечка малых значений, инженерные
// единицы, ограничение шкалой, фильтр первого порядка — точная экспонента по реальному шагу времени.
// 4–20 мА (MilliAmp, Norm420): значение не экстраполируется за насыщение NE 43 (3,8 и 20,5 мА, AI-13)
// ltDt (реакция не зависит от цикла). Без расчёта (xCompute = FALSE: нет корректной Cfg, OutOfService,
// отказ сигнала) фильтр стоит. После подтверждённого отказа и после возврата контроля (xRestart) фильтр
// начинается с текущего значения, без «подтягивания» от старого; короткий неподтверждённый провал
// фильтр только замораживает — после него значение продолжается без скачка (AI-12). Хорошее значение
// для удержания запоминается, пока отказ не подтверждён
METHOD PROTECTED ComputeValue
VAR_INPUT
    xCompute : BOOL;   // значение считается в этом вызове
    xRestart : BOOL;   // фильтр начать заново: отказ подтверждён или сигнал не контролируется
END_VAR
VAR
    lrLo   : LREAL;    // начало шкалы, инж. ед.
    lrSpan : LREAL;    // диапазон шкалы, инж. ед.
    lrX    : LREAL;    // нормированное значение, доли шкалы
    lrEng  : LREAL;    // значение до фильтра, инж. ед.
    lrT_s  : LREAL;    // постоянная времени фильтра, с
    lrSane : LREAL;    // предел |значения| REAL_SANE_MAX
    lrXLo  : LREAL;    // насыщение NE 43 снизу (3,8 мА), доли шкалы
    lrXHi  : LREAL;    // насыщение NE 43 сверху (20,5 мА), доли шкалы
END_VAR
