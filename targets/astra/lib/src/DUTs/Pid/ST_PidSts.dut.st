// Назначение: состояние ПИД-регулятора для HMI/SCADA. 64 байта, 32 регистра Modbus:
//             только 16- и 32-битные поля без скрытого выравнивания.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/fb/FB_PID.md
{attribute 'qualified_only'}
TYPE ST_PidSts :
STRUCT
    stCommon     : ST_DeviceSts;   // 0..27
    rSpTarget_eu : REAL;   // 28: задание после пределов, до рампы
    rSp_eu       : REAL;   // 32: действующее задание (после рампы)
    rPv_eu       : REAL;   // 36: регулируемая величина
    rErr_pct     : REAL;   // 40: ошибка, % диапазона PV, со знаком действия, после зоны нечувствительности
    rOut_pct     : REAL;   // 44: выход
    rP_pct       : REAL;   // 48: пропорциональная составляющая
    rI_pct       : REAL;   // 52: интегральная составляющая
    rD_pct       : REAL;   // 56: дифференциальная составляющая
    rDt_ms       : REAL;   // 60: последний шаг расчёта
END_STRUCT
END_TYPE
