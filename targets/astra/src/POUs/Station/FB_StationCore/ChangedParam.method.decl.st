// Номер первого различающегося параметра уставок станции для события 101017 (04 §18.2: № 2–31 по
// порядку полей ST_StationCfg); таблица тревог или резерв — STN_CFG_PARAM_ALARMS; 0 — уставки
// совпадают. Сравнение по полям, без байтов выравнивания. Структуры — собственными параметрами
// метода (правило R2 контракта); метод без состояния, им пользуется и тест умолчаний
METHOD PUBLIC ChangedParam : UINT
VAR_IN_OUT CONSTANT
    stOld : ST_StationCfg;          // действующая копия
    stNew : ST_StationCfg;          // записанные уставки
END_VAR
VAR
    uiNo  : UINT;                   // номер параметра текущего поля
    uiIdx : UINT;                   // элемент массива
END_VAR
