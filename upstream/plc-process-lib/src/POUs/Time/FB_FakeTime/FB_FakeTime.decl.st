// Назначение: подменяемый источник времени для тестов: время меняется только вызовами
//             SetNow, Advance, AdvanceL, поэтому тесты таймингов детерминированы и не ждут
//             реального времени. Лежит в библиотеке (не в tests/): им пользуются тесты
//             проектов-потребителей. Старт — LTIME#1H, а не 0: ловит код, который считает
//             «0 = не инициализировано».
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/fb/FB_FakeTime.md
FUNCTION_BLOCK FB_FakeTime IMPLEMENTS I_TimeSource
VAR
    ltNow : LTIME := LTIME#1H;   // текущее подменное время
END_VAR
