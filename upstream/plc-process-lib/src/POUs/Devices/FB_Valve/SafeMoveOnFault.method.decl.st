// Шаг 6.7а (VLV-20): аварийный ход в положение безопасности по блокировке, когда отказали только средства
// контроля (BothLimits, PositionLost, FailToOpen, FailToClose), а привод исправен: защита важнее диагностики.
// Только Motorized (соленоид при отказе уходит на пружину, A-10), с положением безопасности Open или Closed; не
// при внешней аварии, муфте, без напряжения и без корректной Cfg. Концевикам при отказе контроля верить нельзя:
// ход заканчивается по согласованному концевику положения безопасности (свой замкнут, встречный нет), по муфте в
// этом направлении или через tTravel. Пока блокировка и отказ держатся, ход не повторяется. Начало — после выбега
// встречного направления (VLV-05).
// Шаг тела FB_Valve; внутренний: PROTECTED (правило L5 контракта), имя зарезервировано для наследников
METHOD PROTECTED SafeMoveOnFault
VAR
    xMayMove : BOOL;   // аварийный ход допустим в этом вызове
    xEnd     : BOOL;   // аварийный ход закончен в этом вызове
END_VAR
