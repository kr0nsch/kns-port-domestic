// Назначение: события станции в журнале (04 §16): номер записи = STN_EVENT_ID_BASE + код.
//             Без strict: значение кода пишется в журнал числом (DESIGN, раздел 3.2).
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел 3.2
{attribute 'qualified_only'}
TYPE E_StationEvent :
(
    StationAuto       := 1,    // режим станции «Автомат»
    StationManual     := 2,    // режим станции «Ручной»
    MethodStepped     := 3,    // способ: ступенчатое
    MethodLevelPid    := 4,    // способ: ПИД уровня
    LeadChanged       := 5,    // смена ведущего (номер насоса)
    AtsPumpIn         := 6,    // АВР: введён насос (номер насоса)
    ContRunHandover   := 7,    // передача роли по ограничению непрерывной работы (номер нового насоса)
    PowerLost         := 8,    // пропадание напряжения
    RestartBegin      := 9,    // начало последовательного пуска
    RestartDone       := 10,   // последовательный пуск завершён (число пущенных)
    FloatMasked       := 11,   // поплавок исключён (102 или 103)
    FloatUnmasked     := 12,   // поплавок возвращён (102 или 103)
    FloatModeOn       := 13,   // переход на управление по поплавкам
    FloatModeOff      := 14,   // возврат к управлению по LT101
    PlcStart          := 15,   // старт приложения ПЛК
    ResetAll          := 16,   // общий сброс (1 — кнопка, 2 — HMI)
    CfgChanged        := 17,   // изменение уставки станции (номер параметра)
    DeviceModeChanged := 18,   // смена режима устройства (dev_no * 10 + режим)
    LogExported       := 19,   // журнал выгружен (строк)
    LogExportFailed   := 20,   // ошибка выгрузки (код ошибки CAA File)
    SimFaultChanged   := 21,   // изменена инъекция отказа (номер поля)
    AckAll            := 22,   // квитировать все
    Silence           := 23    // звук отключён (1 — кнопка, 2 — HMI)
) UINT;
END_TYPE
