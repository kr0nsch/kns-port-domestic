// Насос, с которого снимается запрос, когда нужно меньше насосов (04 §5.2): RunHours — с большей
// наработкой (затем больше пусков, затем больший номер), Cyclic и Fixed — подпорный, выданный
// последним; ведущий — только если подпорных нет. В ПИД (xRequireComm) насос со связью с ПЧ снимается
// последним: остаться должен насос, которым ПИД может управлять (04 §5.2 п. 3). 0 — нет запрошенных
METHOD PRIVATE PickToRemove : UINT
VAR_INPUT
    eRot : E_RotationMode;              // режим чередования
END_VAR
VAR
    uiIdx      : UINT;                  // номер насоса
    uiPass     : UINT;                  // проход: 1 — только насосы без связи (ПИД), 2 — все
    xCommFirst : BOOL;                  // ПИД и есть запрошенный насос без связи
END_VAR
