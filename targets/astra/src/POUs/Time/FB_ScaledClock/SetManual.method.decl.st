// Ручной режим для интеграционных тестов: xOn = TRUE — Now() = ltStart и дальше меняется только
// AdvanceL. xOn = FALSE — возврат к системному времени: часы продолжают от ручного времени
// (перебазирование), время не идёт назад
METHOD PUBLIC SetManual
VAR_INPUT
    xOn     : BOOL;      // включить ручной режим
    ltStart : LTIME;     // время контура в начале ручного режима (при xOn = TRUE)
END_VAR
